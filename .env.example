# Kopieren nach .env und anpassen
# Passwort der PostgreSQL-Datenbank (nur intern gebraucht), zum Beispiel:  openssl rand -hex 16
JULOS_DB_PASSWORD=
# Adresse, auf der der Server lauscht: LAN-Adresse des Docker-Hosts (nur Heimnetz) oder 127.0.0.1 (hinter einem Reverse-Proxy)
BIND_IP=127.0.0.1
BIND_PORT=8080
# Benutzer-ID und Gruppen-ID des Linux-Benutzers, dessen grafische Sitzung du fernsteuerst (Ausgabe von: id -u  und  id -g)
# JULOS_UID=1000
# JULOS_GID=1000
# Verbindungsziele beschraenken (kommagetrennt, leer = alle erlaubt). Ab 0.18 stellst du das in der App ein (Einstellungen, Sicherheit); dies ist nur der Rueckfall
# JULOS_ALLOWED_HOSTS=host.docker.internal
# Schluessel, mit dem gespeicherte Verbindungs-Passwoerter verschluesselt werden (leer = Passwoerter speichern ist aus):  openssl rand -base64 32
# Sichern wie ein Passwort: ohne ihn sind gespeicherte Passwoerter unlesbar. Er gehoert nicht in die Datenbank-Sicherung.
JULOS_SECRET_KEY=
# Taegliche Sicherung der Datenbank (der Schluessel liegt nicht daneben; Wiederherstellungsschluessel in den Einstellungen, Sicherheit), siehe docs/BACKUP.md. Ordner vorher anlegen: mkdir -m 700 ~/julos-backup
# JULOS_BACKUP_PATH=/pfad/auf/dem/host     # Standard: ~/julos-backup
# JULOS_BACKUP=off                          # leer = an, sobald der Ordner da ist
# JULOS_BACKUP_TIME=03:00
# JULOS_BACKUP_KEEP_DAYS=14
# JULOS_BACKUP_KEY=copy                     # Rueckfall: den Schluessel (unverschluesselt) neben die Sicherung legen; schwach, besser den Wiederherstellungsschluessel in der App anlegen
# Zweites Backup-Ziel ausserhalb des Rechners (optional, Standard aus; Einrichtung und Compose-Beispiele: docs/BACKUP.md).
# Ziel nur fuer dich lesbar halten (Ordner 0700). Keine Passwoerter hier: nur Pfade von Dateien, die du nur lesend einbindest.
# JULOS_BACKUP_COPY=path                    # off | path | sftp
# JULOS_BACKUP_COPY_PATH=/backup-copy       # path: Ordner IM Container (z. B. NAS-Einbindung, in docker-compose.yml als Volume eintragen)
# JULOS_BACKUP_COPY=sftp
# JULOS_BACKUP_SFTP_HOST=nas.example.org
# JULOS_BACKUP_SFTP_PORT=22
# JULOS_BACKUP_SFTP_USER=julos
# JULOS_BACKUP_SFTP_PATH=julos-backup       # Ordner auf dem Ziel, muss existieren
# JULOS_BACKUP_SFTP_KEY_FILE=/run/secrets/julos-backup-sftp-key   # privater Schluessel (Pfad im Container, nur lesend einbinden) ...
# JULOS_BACKUP_SFTP_KEY_PASSPHRASE_FILE=    # ... optional mit Passphrase aus einer Datei
# JULOS_BACKUP_SFTP_PASSWORD_FILE=          # ... oder Passwort aus einer Datei (genau eins von beiden)
# JULOS_BACKUP_SFTP_HOST_KEY=               # optional: Host-Schluessel festlegen (SHA256:...), sonst wird er beim ersten Mal gemerkt
# Module Caddy und DDNS (nur lesen, Standard aus, siehe docs/MODULES.md). Werte: off | read
# Dienste-Widgets: off (Standard), read (nur ansehen) oder control (anlegen und aendern). Abgefragt werden nur gespeicherte Adressen im eigenen Netz;
# andere Ziele nur, wenn sie hier (oder in JULOS_ALLOWED_HOSTS) stehen. Siehe docs/MODULES.md
# JULOS_SERVICES=control
# JULOS_SERVICES_HOSTS=jularr.lan,nas.lan
# JULOS_CADDY=read
# JULOS_CADDYFILE=/etc/julos/Caddyfile
# JULOS_CADDY_ADMIN_URL=
# JULOS_CADDY_ADMIN_AUTH_FILE=/run/secrets/caddy-admin    # optional: Bearer, Basic oder benutzer:passwort, eine Zeile, nur lesend einbinden
# JULOS_CADDY_TLS_CONNECT=caddy:443                       # optional: wohin die TLS-Handshakes fuer die Zertifikate gehen (sonst Domain:443)
# JULOS_CADDY_LOG_FILE=/var/log/caddy/access.log          # optional: Zugriffsprotokoll (JSON-Zeilen), nur lesend einbinden
# JULOS_DDNS=read
# JULOS_DDNS_HOSTS=home.example.org,nas.example.org
# JULOS_DDNS_FRITZBOX_URL=http://192.0.2.1:49000
# JULOS_DDNS_IP_URL=
# DDNS schreiben (nur mit JULOS_DDNS=control; zuerst pruefen, ob ein anderer Dienst, zum Beispiel ein Caddy-Aufsatz, dieselben Eintraege schon aktualisiert):
# JULOS_DDNS_PROVIDER=cloudflare             # cloudflare | duckdns | generic
# JULOS_DDNS_CLOUDFLARE_ZONE=                # Zonen-Kennung (Cloudflare); der Token gehoert nur zu dieser Zone und darf nur DNS bearbeiten
# JULOS_DDNS_TOKEN_FILE=/run/secrets/ddns-token    # Token (Cloudflare, DuckDNS) aus einer Datei, nur lesend einbinden
# JULOS_DDNS_UPDATE_URL=                     # generic: Adresse mit {host} und {ip}, kann ein Token enthalten (wird nie angezeigt)
# JULOS_DDNS_UPDATE_AUTH_FILE=               # generic, optional: benutzer:passwort oder "Bearer ..." aus einer Datei
# JULOS_DDNS_AUTO=on                         # automatisch aktualisieren (eigener Schalter, Standard aus) ...
# JULOS_DDNS_AUTO_SECONDS=300                # ... hoechstens alle 5 Minuten (kleiner wird auf 300 angehoben)
