# Kopieren nach .env und anpassen
# Schluessel fuer die kurzlebigen Anmelde-Token: genau 32 Zeichen, zum Beispiel:  openssl rand -hex 16
TOKEN_KEY=
# Linux-Benutzer auf dem Zielrechner (das Passwort tippst du beim Verbinden selbst ein)
RDP_USER=
# Adresse, auf der das Gateway lauscht: LAN-Adresse des Docker-Hosts (nur Heimnetz) oder 127.0.0.1 (hinter einem Reverse-Proxy)
BIND_IP=127.0.0.1
BIND_PORT=8080
# Ziel des RDP-Zugriffs aus Sicht des Containers (Standard: der Docker-Host selbst)
# RDP_HOST=host.docker.internal
# RDP_PORT=3389
# Betrieb hinter HTTPS-Proxy: geheimer Header, siehe tools/enable-proxy-mode.sh
# PROXY_SECRET=
