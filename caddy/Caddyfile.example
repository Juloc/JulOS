# Beispiel fuer DEIN vorhandenes Caddy (v2.7+). Anpassen: Domain, Pfade, IP der VM.
# Voraussetzungen:
#  1) Der JulOS-Server laeuft und du hast dein Konto angelegt (eigene Anmeldung schuetzt die Seite)
#  2) Optional als Zusatzschicht: tools/make-client-cert.sh ausgefuehrt, pki/ca.crt auf den Caddy-Rechner kopiert (den tls-Block unten sonst weglassen)
#  3) Router/UniFi: Port 443 auf den Caddy-Rechner weiterleiten, DNS der Domain auf deine IP
desktop.example.com {
	# Optionaler Zusatzschutz fuer den Internetzugang: nur Geraete mit deinem Client-Zertifikat kommen durch (mTLS)
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/julos-ca.crt
			# aeltere Caddy-Versionen: trusted_ca_cert_file /etc/caddy/julos-ca.crt
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# WebSocket (guacamole) wird von reverse_proxy automatisch durchgereicht
	reverse_proxy <IP-des-Docker-Hosts>:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}
