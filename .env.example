# Kopieren nach .env und anpassen
# Passwort der PostgreSQL-Datenbank (nur intern gebraucht), zum Beispiel:  openssl rand -hex 16
JULOS_DB_PASSWORD=
# Adresse, auf der der Server lauscht: LAN-Adresse des Docker-Hosts (nur Heimnetz) oder 127.0.0.1 (hinter einem Reverse-Proxy)
BIND_IP=127.0.0.1
BIND_PORT=8080
# Benutzer-ID und Gruppen-ID des Linux-Benutzers, dessen grafische Sitzung du fernsteuerst (Ausgabe von: id -u  und  id -g)
# JULOS_UID=1000
# JULOS_GID=1000
# Verbindungsziele beschraenken (kommagetrennt, leer = alle erlaubt)
# JULOS_ALLOWED_HOSTS=host.docker.internal
# Schluessel, mit dem gespeicherte Verbindungs-Passwoerter verschluesselt werden (leer = Passwoerter speichern ist aus):  openssl rand -base64 32
# Sichern wie ein Passwort: ohne ihn sind gespeicherte Passwoerter unlesbar. Er gehoert nicht in die Datenbank-Sicherung.
JULOS_SECRET_KEY=
# Module Caddy und DDNS (nur lesen, Standard aus, siehe docs/MODULES.md). Werte: off | read
# JULOS_CADDY=read
# JULOS_CADDYFILE=/etc/julos/Caddyfile
# JULOS_CADDY_ADMIN_URL=
# JULOS_DDNS=read
# JULOS_DDNS_HOSTS=home.example.org,nas.example.org
# JULOS_DDNS_FRITZBOX_URL=http://192.0.2.1:49000
# JULOS_DDNS_IP_URL=
