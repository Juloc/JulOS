<Project>
  <!-- Alle Paketversionen stehen hier, Projekte nennen nur den Namen. Laufzeit: Npgsql, Argon2 und SSH.NET (SSH-Terminal). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Anmelde-Zentrale (docs/SIGN-IN.md): Microsofts Token-Bibliothek; der OpenID-Connect-Handler nur in den Tests, als Standard-Client gegen JulOS -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
  </ItemGroup>
</Project>
